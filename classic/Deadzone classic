    FrameStroke.Parent = Frame
    table.insert(ThemeStrokes, FrameStroke)

    local Label = Instance.new("TextLabel")
    Label.Name = "Title"
    Label.Size = UDim2.new(1, -80, 0, 20)
    Label.Position = UDim2.new(0, 8, 0, 2)
