-- =================================================================
-- LOGIC & CORE FUNCTIONS
-- =================================================================
local function NewText(Size)
    local T = Drawing.new("Text")
    T.Visible = false
    T.Center = true
    T.Outline = true
    T.Font = 2
    T.Size = Size
    T.Color = Color3.new(1, 1, 1)
    return T
end

local function NewLine()
    local L = Drawing.new("Line")
    L.Visible = false
    L.Thickness = 1.5
    L.Transparency = 1
    return L
end

local function HideESP(E)
    for _, v in pairs(E) do
        v.Visible = false
    end
end

local function CreateESP(Player)
    if Player == LocalPlayer then return end
    ESP[Player] = {
        Top = NewLine(),
        Bottom = NewLine(),
        Left = NewLine(),
        Right = NewLine(),
        HealthBG = NewLine(),
        HealthMain = NewLine(),
        Tracer = NewLine(),
        Name = NewText(14),
        Distance = NewText(12)
    }
end

local function RemoveESP(Player)
    if ESP[Player] then
        for _, v in pairs(ESP[Player]) do
            v:Remove()
        end
        ESP[Player] = nil
    end
    if Highlights[Player] then
        Highlights[Player]:Destroy()
        Highlights[Player] = nil
    end
    CachedModels[Player] = nil
end

local function FindModel(Player)
    if Player.Character then return Player.Character end
    local Model = workspace:FindFirstChild(Player.Name, true)
    if Model and Model:IsA("Model") then
        return Model
    end
    return nil
end

local function CreateHighlight(Player, Model)
    if Highlights[Player] then
        Highlights[Player]:Destroy()
    end
    local H = Instance.new("Highlight")
    H.Name = "PlayerESP"
    H.FillTransparency = 0.65
    H.OutlineTransparency = 0
    H.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    H.Parent = Model
    H.Adornee = Model
    Highlights[Player] = H
end

local function UpdateModel(Player)
    local Model = FindModel(Player)
    if Model then
        CachedModels[Player] = Model
        CreateHighlight(Player, Model)
    end
end

local function SetupPlayer(Player)
    if Player == LocalPlayer then return end
    CreateESP(Player)
    UpdateModel(Player)

    Player.CharacterAdded:Connect(function(Char)
        CachedModels[Player] = Char
        task.wait(1)
        UpdateModel(Player)
    end)
end

for _, Player in pairs(Players:GetPlayers()) do
    SetupPlayer(Player)
end

Players.PlayerAdded:Connect(SetupPlayer)
Players.PlayerRemoving:Connect(RemoveESP)

task.spawn(function()
    while true do
        for _, Player in pairs(Players:GetPlayers()) do
            if Player ~= LocalPlayer then
                local Model = CachedModels[Player]
                if not Model or not Model.Parent then
                    UpdateModel(Player)
                end
            end
        end
        task.wait(2)
    end
end)

local function ResetHeads()
    for Head, Size in pairs(OriginalHeadSizes) do
        if Head and Head.Parent then
            Head.Size = Size
        else
            OriginalHeadSizes[Head] = nil
        end
    end
end

local function IsVisible(Model, Part)
    local Origin = Camera.CFrame.Position
    local Direction = Part.Position - Origin
    local Params = RaycastParams.new()
    Params.FilterType = Enum.RaycastFilterType.Blacklist
    
    local filterList = {Model}
    if LocalPlayer.Character then
        table.insert(filterList, LocalPlayer.Character)
    end
    Params.FilterDescendantsInstances = filterList

    local Result = workspace:Raycast(Origin, Direction, Params)
    return Result == nil
end

local function GetPrediction(Distance)
    if Distance >= 3000 then return 2 end
    if Distance >= 2000 then return 1.50 end
    if Distance >= 1000 then return 1 end
    if Distance >= 500 then return 0.35 end
    return Settings.BasePrediction
end

-- =================================================================
-- MAIN LOOP & THEMES
-- =================================================================
RunService.RenderStepped:Connect(function(deltaTime)
    local ViewportSize = Camera.ViewportSize
    local Center = Vector2.new(ViewportSize.X / 2, ViewportSize.Y / 2)

    -- ЦВЕТОВЫЕ ТЕМЫ
    local ThemeColor = Color3.fromRGB(0, 255, 170)
    
    if Settings.Theme == "Rainbow" then
        RainbowHue = RainbowHue + 0.004
        if RainbowHue > 1 then RainbowHue = 0 end
        ThemeColor = Color3.fromHSV(RainbowHue, 0.9, 1)
    elseif Settings.Theme == "Red" then
        ThemeColor = Color3.fromRGB(255, 40, 40)
    elseif Settings.Theme == "Blue" then
        ThemeColor = Color3.fromRGB(0, 150, 255)
    elseif Settings.Theme == "Green" then
        ThemeColor = Color3.fromRGB(40, 220, 80)
    elseif Settings.Theme == "Purple" then
        ThemeColor = Color3.fromRGB(170, 0, 255)
    end

    MainUIStroke.Color = ThemeColor
    ToggleOpenStroke.Color = ThemeColor

    for _, stroke in pairs(ThemeStrokes) do
        stroke.Color = ThemeColor
    end

    for _, fill in pairs(ThemeFills) do
        fill.BackgroundColor3 = ThemeColor
    end

    -- Обновление позиции и цвета круглого FOV
    Circle.Position = Center
    CircleOutline.Position = Center
    Dot.Position = Center

    Circle.Color = ThemeColor
    CircleOutline.Color = ThemeColor
    Dot.Color = ThemeColor
    Line.Color = ThemeColor
    NameTag.Color = ThemeColor

    local isAimbotOn = Settings.Aimbot
    Circle.Visible = isAimbotOn
    CircleOutline.Visible = isAimbotOn
    Dot.Visible = isAimbotOn

    -- Позиционирование меток (Crosshair Ticks) как на фото
    local tickOffset = math.clamp(Settings.FOV * 0.45, 15, 60)
    local tickLength = 10

    Ticks.Top.From = Vector2.new(Center.X, Center.Y - tickOffset)
    Ticks.Top.To = Vector2.new(Center.X, Center.Y - tickOffset - tickLength)

    Ticks.Bottom.From = Vector2.new(Center.X, Center.Y + tickOffset)
    Ticks.Bottom.To = Vector2.new(Center.X, Center.Y + tickOffset + tickLength)

    Ticks.Left.From = Vector2.new(Center.X - tickOffset, Center.Y)
    Ticks.Left.To = Vector2.new(Center.X - tickOffset - tickLength, Center.Y)

    Ticks.Right.From = Vector2.new(Center.X + tickOffset, Center.Y)
    Ticks.Right.To = Vector2.new(Center.X + tickOffset + tickLength, Center.Y)

    for _, tick in pairs(Ticks) do
        tick.Color = ThemeColor
        tick.Visible = isAimbotOn
    end

    -- AIMBOT LOGIC
    local ClosestTarget = nil
    local ClosestHead = nil
    local ClosestDistance = math.huge
    local ClosestScreenPos = nil
    local ClosestPlayerName = nil
    local ClosestWorldDistance = nil

    if Settings.Aimbot then
        for Player, Model in pairs(CachedModels) do
            if Model and Model.Parent then
                local Humanoid = Model:FindFirstChildOfClass("Humanoid")
                local TargetPartName = (Settings.AimPart == "Torso") and "HumanoidRootPart" or "Head"
                local TargetPart = Model:FindFirstChild(TargetPartName, true)
                local Head = Model:FindFirstChild("Head", true)

                if Humanoid and Humanoid.Health > 0 and TargetPart then
                    local Character = LocalPlayer.Character
                    if Character and Character:FindFirstChild("HumanoidRootPart") then
                        local WorldDist = (Character.HumanoidRootPart.Position - TargetPart.Position).Magnitude
                        
                        if WorldDist <= Settings.MaxAimDistance then
                            local Pos, Visible = Camera:WorldToViewportPoint(TargetPart.Position)
                            if Visible and IsVisible(Model, TargetPart) then
                                local ScreenPos = Vector2.new(Pos.X, Pos.Y)
                                local ScreenDist = (ScreenPos - Center).Magnitude

                                if ScreenDist <= Settings.FOV and ScreenDist < ClosestDistance then
                                    ClosestDistance = ScreenDist
                                    ClosestTarget = TargetPart
                                    ClosestHead = Head
                                    ClosestScreenPos = ScreenPos
                                    ClosestPlayerName = Player.Name
                                    ClosestWorldDistance = WorldDist

                                    if Head and not OriginalHeadSizes[Head] then
                                        OriginalHeadSizes[Head] = Head.Size
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- BIG HEADS LOGIC
    ResetHeads()
    if Settings.BigHeads and ClosestHead then
        ClosestHead.Size = Vector3.new(2, 2, 2)
    end

    -- AIMBOT TARGET INDICATOR & CAMERA LERP
    if Settings.Aimbot and ClosestScreenPos then
        Line.Visible = true
        Line.From = Center
        Line.To = ClosestScreenPos

        NameTag.Visible = true
        NameTag.Text = ClosestPlayerName
        NameTag.Position = Vector2.new(ClosestScreenPos.X, ClosestScreenPos.Y - 25)
    else
        Line.Visible = false
        NameTag.Visible = false
    end

    if Settings.Aimbot and ClosestTarget then
        local Prediction = GetPrediction(ClosestWorldDistance or 0)
        local PredictedPosition = ClosestTarget.Position + (ClosestTarget.Velocity * Prediction)

        Camera.CFrame = Camera.CFrame:Lerp(
            CFrame.new(Camera.CFrame.Position, PredictedPosition),
            Settings.Smoothness
        )
    end

    -- ESP LOGIC
    local Character = LocalPlayer.Character
    local LocalRoot = Character and Character:FindFirstChild("HumanoidRootPart")

    for Player, E in pairs(ESP) do
        local Model = CachedModels[Player]
        local Highlight = Highlights[Player]

        if Highlight then
            Highlight.Enabled = Settings.Highlight
        end

        if not Model or not LocalRoot then
            HideESP(E)
            continue
        end

        local Root = Model:FindFirstChild("HumanoidRootPart", true) or Model:FindFirstChild("Head", true) or Model.PrimaryPart
        local Humanoid = Model:FindFirstChildOfClass("Humanoid")

        if not Root or not Humanoid or Humanoid.Health <= 0 then
            HideESP(E)
            continue
        end

        local Distance = (LocalRoot.Position - Root.Position).Magnitude

        if Distance > Settings.MaxEspDistance then
            HideESP(E)
            if Highlight then Highlight.Enabled = false end
            continue
        end

        local Pos, Visible = Camera:WorldToViewportPoint(Root.Position)
        if not Visible then
            HideESP(E)
            continue
        end

        local Color = Color3.fromRGB(0, 255, 170)
        if Distance <= 1000 then Color = Color3.fromRGB(255, 170, 0) end
        if Distance <= 500 then Color = Color3.fromRGB(255, 0, 0) end

        if Highlight then
            Highlight.FillColor = Color
            Highlight.OutlineColor = Color
        end

        local Scale = math.clamp(1200 / Pos.Z, 0.7, 1.3)
        local Width = 15 * Scale
        local Height = 26 * Scale
        local X, Y = Pos.X, Pos.Y

        -- 1. BOX ESP
        if Settings.ESP_Box then
            E.Top.From = Vector2.new(X - Width, Y - Height)
            E.Top.To = Vector2.new(X + Width, Y - Height)

            E.Bottom.From = Vector2.new(X - Width, Y + Height)
            E.Bottom.To = Vector2.new(X + Width, Y + Height)

            E.Left.From = Vector2.new(X - Width, Y - Height)
            E.Left.To = Vector2.new(X - Width, Y + Height)

            E.Right.From = Vector2.new(X + Width, Y - Height)
            E.Right.To = Vector2.new(X + Width, Y + Height)

            E.Top.Color, E.Bottom.Color, E.Left.Color, E.Right.Color = Color, Color, Color, Color
            E.Top.Visible, E.Bottom.Visible, E.Left.Visible, E.Right.Visible = true, true, true, true
        else
            E.Top.Visible, E.Bottom.Visible, E.Left.Visible, E.Right.Visible = false, false, false, false
        end

        -- 2. HEALTHBAR ESP
        if Settings.ESP_Health then
            local HealthPercent = math.clamp(Humanoid.Health / Humanoid.MaxHealth, 0, 1)
            local BarX = X - Width - 5
            local BarHeight = Height * 2
            local BarBottom = Y + Height
            local BarTop = BarBottom - (BarHeight * HealthPercent)

            E.HealthBG.From = Vector2.new(BarX, Y - Height)
            E.HealthBG.To = Vector2.new(BarX, BarBottom)
            E.HealthBG.Color = Color3.fromRGB(30, 30, 30)
            E.HealthBG.Thickness = 3
            E.HealthBG.Visible = true

            E.HealthMain.From = Vector2.new(BarX, BarBottom)
            E.HealthMain.To = Vector2.new(BarX, BarTop)
            E.HealthMain.Color = Color3.fromHSV(HealthPercent * 0.3, 0.9, 1)
            E.HealthMain.Thickness = 1.5
            E.HealthMain.Visible = true
        else
            E.HealthBG.Visible = false
            E.HealthMain.Visible = false
        end

        -- 3. TRACERS ESP
        if Settings.ESP_Tracer then
            E.Tracer.From = Vector2.new(ViewportSize.X / 2, ViewportSize.Y)
            E.Tracer.To = Vector2.new(X, Y + Height)
            E.Tracer.Color = Color
            E.Tracer.Visible = true
        else
            E.Tracer.Visible = false
        end

        -- 4. NAME ESP
        if Settings.ESP_Name then
            E.Name.Position = Vector2.new(X, Y - Height - 14)
            E.Name.Text = Player.Name
            E.Name.Visible = true
        else
            E.Name.Visible = false
        end

        -- 5. DISTANCE ESP
        if Settings.ESP_Distance then
            E.Distance.Position = Vector2.new(X, Y + Height + 2)
            E.Distance.Text = math.floor(Distance) .. "m"
            E.Distance.Visible = true
        else
            E.Distance.Visible = false
        end
    end
end)
