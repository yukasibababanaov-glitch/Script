local function createToggle(parent, text, defaultState, callback)
	local frame = Instance.new("Frame", parent)
	frame.Size = UDim2.new(1, -10, 0, 40)
	frame.BackgroundColor3 = cardBg
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

	local lbl = Instance.new("TextLabel", frame)
	lbl.Size = UDim2.new(0.7, 0, 1, 0)
	lbl.Position = UDim2.new(0, 12, 0, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = text
	lbl.TextColor3, lbl.TextSize, lbl.Font = Color3.fromRGB(240, 240, 240), 13, FontStyle
	lbl.TextXAlignment = Enum.TextXAlignment.Left

	local btn = Instance.new("TextButton", frame)
	btn.Size = UDim2.new(0, 55, 0, 26)
	btn.Position = UDim2.new(1, -65, 0.5, -13)
	btn.BackgroundColor3 = defaultState and mainPurple or Color3.fromRGB(50, 45, 60)
	btn.Text = defaultState and "ON" or "OFF"
	btn.TextColor3 = defaultState and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 160, 160)
	btn.TextSize = 12
	btn.Font = FontStyle
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

	local state = defaultState
	btn.MouseButton1Click:Connect(function()
		state = not state
		btn.Text = state and "ON" or "OFF"
		btn.BackgroundColor3 = state and mainPurple or Color3.fromRGB(50, 45, 60)
		btn.TextColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 160, 160)
		callback(state)
	end)
end

