-- Поиск целей
local function getP()
	local t = {"ВСЕ"}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then table.insert(t, p.Name) end
	end
	return t
end

local function getC()
	local c, s = nil, math.huge
	if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return nil end
	local mP = LocalPlayer.Character.HumanoidRootPart.Position
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild(part) and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
			if sel ~= "ВСЕ" and p.Name ~= sel then continue end
			local d = (mP - p.Character[part].Position).Magnitude
			if d < s then s, c = d, p end
		end
	end
	return c
end

