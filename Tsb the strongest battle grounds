-- ЧИСТЫЙ ESP МОДУЛЬ (ХИЛБАР СЛЕВА, БЕЗ БОКСОВ)
----------------------------------------------------
local function applyESP(player)
	if player == LocalPlayer then return end

	local function characterAdded(char)
		local root = char:WaitForChild("HumanoidRootPart", 10)
		local humanoid = char:WaitForChild("Humanoid", 10)
		if not root or not humanoid then return end

		-- BillboardGui над персонажем
		local bb = Instance.new("BillboardGui")
		bb.Name = "ESP_Billboard"
		bb.Size = UDim2.new(0, 180, 0, 30)
		bb.StudsOffset = Vector3.new(0, 3.5, 0)
		bb.AlwaysOnTop = true
		bb.Adornee = root
		bb.Parent = root

		-- Контейнер
		local container = Instance.new("Frame", bb)
		container.Size = UDim2.new(1, 0, 1, 0)
		container.BackgroundTransparency = 1

		-- Хилбар (Слева)
		local healthBg = Instance.new("Frame", container)
		healthBg.Name = "HealthBg"
		healthBg.Size = UDim2.new(0, 4, 0, 24)
		healthBg.Position = UDim2.new(0, 10, 0.5, -12)
		healthBg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		healthBg.BorderSizePixel = 1
		healthBg.BorderColor3 = Color3.fromRGB(0, 0, 0)

		local healthFill = Instance.new("Frame", healthBg)
		healthFill.Name = "HealthFill"
		healthFill.Size = UDim2.new(1, 0, 1, 0)
		healthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
		healthFill.BorderSizePixel = 0

		-- Текст (Справа от Хилбара)
		local infoLabel = Instance.new("TextLabel", container)
		infoLabel.Name = "InfoLabel"
		infoLabel.Size = UDim2.new(1, -22, 1, 0)
		infoLabel.Position = UDim2.new(0, 20, 0, 0)
		infoLabel.BackgroundTransparency = 1
		infoLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		infoLabel.TextStrokeTransparency = 0
		infoLabel.TextSize = 13
		infoLabel.Font = FontStyle
		infoLabel.TextXAlignment = Enum.TextXAlignment.Left

		-- Chams (Подсветка)
		local highlight = Instance.new("Highlight")
		highlight.Name = "ESP_Highlight"
		highlight.Adornee = char
		highlight.FillTransparency = 0.5
		highlight.OutlineTransparency = 0
		highlight.FillColor = mainPurple
		highlight.Parent = char

		-- Обновление значений в реальном времени
		local conn
		conn = RunService.RenderStepped:Connect(function()
			if not char or not char.Parent or not root or not humanoid or humanoid.Health <= 0 then
				bb:Destroy()
				if highlight then highlight:Destroy() end
				if conn then conn:Disconnect() end
				return
			end

			if espEnabled then
				bb.Enabled = true
				highlight.Enabled = espChams

				-- Обновление Хилбара
				if espHealth then
					healthBg.Visible = true
					local hpPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
					healthFill.Size = UDim2.new(1, 0, hpPercent, 0)
					healthFill.Position = UDim2.new(0, 0, 1 - hpPercent, 0)

					if hpPercent > 0.5 then
						healthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
					elseif hpPercent > 0.2 then
						healthFill.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
					else
						healthFill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
					end
				else
					healthBg.Visible = false
				end

				-- Обновление текста
				if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
					local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude)
					local str = ""
					if espNames then str = str .. player.Name .. " " end
					if espDist then str = str .. "[" .. tostring(dist) .. "m]" end
					infoLabel.Text = str
					infoLabel.Visible = (espNames or espDist)
				else
					infoLabel.Visible = false
				end
			else
				bb.Enabled = false
				highlight.Enabled = false
			end
		end)
	end

	if player.Character then
		task.spawn(characterAdded, player.Character)
	end
	player.CharacterAdded:Connect(characterAdded)
end

